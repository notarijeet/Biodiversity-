# .env.example  —  copy to .env and fill in your values.
#
#   cp .env.example .env
#
# NEVER commit .env to git.  .gitignore already excludes .env* files.

# ── Hardware / Inference device ────────────────────────────────────────────
# Leave empty to auto-detect (CUDA if available, else CPU).
# Set to "cpu" to force CPU inference (default for Docker and offline demo).
DEVICE=cpu

# ── Database ────────────────────────────────────────────────────────────────
# SQLite (default — file created next to main.py on first run):
DATABASE_URL=sqlite:///./wildlife_cases.db
#
# PostgreSQL example (Phase 3+):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/iwt_db

# ── CORS ────────────────────────────────────────────────────────────────────
# Origin of the React frontend (Vite default port).
FRONTEND_ORIGIN=http://localhost:5173

# ── Optional demo enrichment (not part of core ML pipeline) ─────────────────
# Leave blank unless you want Gemini-powered explanation enrichment.
# Never put a real key here in a committed file.
GEMINI_API_KEY=

# ── Model paths (override defaults from config.py) ───────────────────────────
# Absolute path to the XLM-RoBERTa fine-tuned checkpoint directory.
# Leave blank to fall back to the TF-IDF baseline automatically.
# TEXT_MODEL_CHECKPOINT=
#
# CLIP model name (HuggingFace Hub ID or local path).
# CLIP_MODEL_NAME=openai/clip-vit-base-patch32
