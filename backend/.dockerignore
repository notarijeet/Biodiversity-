# Docker ignore file for the backend image build.
# Keeps the image small and prevents secrets/data from being baked in.

# Virtual environment (use the installed system packages instead)
.venv/

# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# Data files (mounted as volumes at runtime — NEVER baked into image)
# data/raw/ and data/processed/ are gitignored and must NOT ship in the image.
# data/lexicons/ is small and tracked in git; it IS copied into the image.
# Override with a named volume in docker-compose.yml if you want hot-reload.
../data/raw/
../data/processed/

# Model checkpoints (too large for image; mount as volume)
models/checkpoints/

# Local env files (secrets)
.env
.env.*
!.env.example

# Test artifacts
.pytest_cache/
.ruff_cache/
htmlcov/
*.coverage

# IDE / OS
.DS_Store
*.swp
Thumbs.db

# Notebooks (not needed in prod image)
../notebooks/
